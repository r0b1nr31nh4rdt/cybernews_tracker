{
  "manifest_version": 3,
  "name": "CyberNews Inbox",
  "version": "1.0",
  "description": "Speichert den aktuellen Tab in die CyberNews Link Inbox",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://cybernewstracker-staging.up.railway.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png",
    "default_title": "In Inbox speichern"
  }
}
